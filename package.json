{
  "name": "global-elektronik",
  "version": "1.0.0",
  "description": "Inventory Management System for Global Elektronik",
  "main": "server.js",
  "scripts": {
    "build": "npm install",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node -e \"require('./config/database.js').initializeDatabase().then(() => process.exit(0)).catch(() => process.exit(1))\"",
    "test-connection": "node -e \"require('./config/database.js').testConnection().then(() => process.exit(0)).catch(() => process.exit(1))\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "inventory",
    "management",
    "electronik",
    "mysql",
    "express",
    "jwt",
    "authentication"
  ],
  "author": "Global Elektronik",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
